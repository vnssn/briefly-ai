GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Arcjet per-visitor protection (shield, bot detection, per-IP rate limit).
# Get a site key at https://console.arcjet.com. Omit locally to run unprotected.
ARCJET_KEY=

# App budgets tuned to Groq's free tier for openai/gpt-oss-120b
# (30 RPM / 1K RPD / 8K TPM per https://console.groq.com/docs/rate-limits).
# These are conservative application ceilings, not claims about your quota.
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100
AI_INPUT_BUDGET_PER_MINUTE=8000
# Required for live AI on Vercel. Use the same database/namespace across deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_QUOTA_NAMESPACE=briefly:quota:v1

# Vercel integration also supports KV_REST_API_URL and KV_REST_API_TOKEN automatically.
